{
  "name": "cert-mock-exam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm validate && tsc -b && vite build",
    "preview": "vite preview",
    "preview:workers": "wrangler dev",
    "validate": "node scripts/validate-exams.ts && node scripts/validate-exams.ts tests/fixtures/exams",
    "convert": "node scripts/convert-artifact.ts",
    "check": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "e2e:server": "pnpm build:e2e && rm -rf .wrangler/e2e && wrangler d1 migrations apply DB --local -c wrangler.e2e.jsonc --persist-to .wrangler/e2e && wrangler dev -c wrangler.e2e.jsonc --ip 127.0.0.1 --port 4173 --persist-to .wrangler/e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-jp": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
