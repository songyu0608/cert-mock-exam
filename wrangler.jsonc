{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cert-mock-exam",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 주소가 /exam/aws-aif-c01 처럼 바뀌어도 새로고침하면 index.html을 돌려준다.
    "not_found_handling": "single-page-application",
    // 기록 동기화 API만 Worker 코드가 처리한다.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cert-mock-exam",
      // Cloudflare 대시보드에서 만든 D1의 Database ID(비밀 값 아님)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // 동기화를 허용할 비밀키의 등록 코드(SHA-256 16진수). 여러 개면 쉼표로 구분한다.
    // 키 원문은 절대 넣지 않는다.
    "SYNC_KEY_HASHES": "",
  },
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
}
